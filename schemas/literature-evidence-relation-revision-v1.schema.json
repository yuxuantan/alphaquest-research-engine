{
  "$defs": {
    "ActorProvenanceV1": {
      "additionalProperties": false,
      "properties": {
        "actor_class": {
          "enum": [
            "CODEX",
            "HUMAN_OWNER_RESEARCHER",
            "ALPHAQUEST_DETERMINISTIC_ENGINE"
          ],
          "title": "Actor Class",
          "type": "string"
        },
        "actor_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "title": "Actor Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "actor_class",
        "actor_id"
      ],
      "title": "ActorProvenanceV1",
      "type": "object"
    },
    "RecordReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,255}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_sha256"
      ],
      "title": "RecordReferenceV1",
      "type": "object"
    }
  },
  "$id": "https://alphaquest.local/schemas/literature-evidence-relation-revision-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorProvenanceV1"
    },
    "append_sequence": {
      "minimum": 1,
      "title": "Append Sequence",
      "type": "integer"
    },
    "claim_refs": {
      "items": {
        "$ref": "#/$defs/RecordReferenceV1"
      },
      "minItems": 2,
      "title": "Claim Refs",
      "type": "array"
    },
    "evidence_relation_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Evidence Relation Id",
      "type": "string"
    },
    "idempotency_key": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "previous_revision_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Revision Sha256"
    },
    "previous_store_record_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Store Record Sha256"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,255}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "relationship": {
      "enum": [
        "REPLICATES",
        "FAILS_TO_REPLICATE",
        "CONTRADICTS",
        "EXTENDS",
        "REGIME_QUALIFIES",
        "ALTERNATIVE_EXPLANATION"
      ],
      "title": "Relationship",
      "type": "string"
    },
    "relationship_basis": {
      "enum": [
        "SOURCE_STATED",
        "ALPHAQUEST_EXPLICIT_INFERENCE"
      ],
      "title": "Relationship Basis",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema": {
      "const": "alphaquest.literature-evidence-relation-revision/v1",
      "title": "Schema",
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "RETRACTED",
        "SUPERSEDED"
      ],
      "title": "Status",
      "type": "string"
    },
    "superseded_by_relation_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By Relation Id"
    }
  },
  "required": [
    "schema",
    "record_id",
    "append_sequence",
    "recorded_at",
    "actor",
    "idempotency_key",
    "intent_sha256",
    "record_sha256",
    "revision",
    "evidence_relation_id",
    "relationship",
    "claim_refs",
    "relationship_basis",
    "rationale",
    "status"
  ],
  "title": "EvidenceRelationRevisionV1",
  "type": "object"
}
