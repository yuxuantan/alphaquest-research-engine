            "UTF8_SORTED_KEYS_COMPACT_JSON_NO_NAN_FINAL_LF"
          ],
          "title": "Canonicalization",
          "type": "string"
        },
        "digest": {
          "const": "SHA256_LOWERCASE_HEX",
          "enum": [
            "SHA256_LOWERCASE_HEX"
          ],
          "title": "Digest",
          "type": "string"
        },
        "hash_scope": {
          "const": "EXACT_CANONICAL_TAXONOMY_FILE_BYTES_INCLUDING_FINAL_LF",
          "enum": [
            "EXACT_CANONICAL_TAXONOMY_FILE_BYTES_INCLUDING_FINAL_LF"
          ],
          "title": "Hash Scope",
          "type": "string"
        }
      },
      "required": [
        "canonicalization",
        "digest",
        "hash_scope"
