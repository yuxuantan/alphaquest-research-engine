        "alphaquest.edge-backlog-fingerprint/v1"
      ],
      "title": "Fingerprint Schema",
      "type": "string"
    },
    "previous_taxonomy_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Taxonomy Sha256"
    },
    "prohibited_concept_categories": {
      "items": {
        "enum": [
          "COSMETIC_TIMEFRAMES",
          "ENTRY_OR_EXIT_RULES",
          "EXACT_TIMEFRAMES",
          "FREE_FORM_UNKNOWN_OTHER_AND_CUSTOM_ESCAPE_CHANNELS",
          "INDICATORS",
          "PARAMETER_VALUES",
          "PERFORMANCE_AND_PNL_CLAIMS",
          "POSITION_SIZING_AND_RISK_RULES",
          "STOPS",
          "STRATEGY_IMPLEMENTATIONS",
          "STRATEGY_MODULES",
          "TARGETS",
          "THRESHOLDS",
          "TRADE_ACTIONS",
          "TRIGGERS",
          "VERDICT_APPROVAL_ADMISSION_CERTIFICATION_AND_DEPLOYMENT_CLAIMS"
