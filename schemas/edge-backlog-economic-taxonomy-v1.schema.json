    "CrossFieldInvariantV1": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "if_any": {
          "items": {
            "$ref": "#/$defs/TaxonomySelectionV1"
          },
          "minItems": 1,
          "title": "If Any",
          "type": "array"
        },
        "invariant_id": {
          "pattern": "^[a-z][a-z0-9_]{2,127}$",
          "title": "Invariant Id",
          "type": "string"
        },
        "require_all": {
          "items": {
            "$ref": "#/$defs/TaxonomySelectionV1"
          },
          "title": "Require All",
          "type": "array"
        },
        "require_any": {
          "items": {
            "$ref": "#/$defs/TaxonomySelectionV1"
          },
          "title": "Require Any",
          "type": "array"
        }
      },
      "required": [
        "invariant_id",
        "definition",
        "if_any"
      ],
      "title": "CrossFieldInvariantV1",
      "type": "object"
    },
