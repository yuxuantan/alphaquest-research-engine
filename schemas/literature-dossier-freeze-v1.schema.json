{
  "$defs": {
    "ActorProvenanceV1": {
      "additionalProperties": false,
      "properties": {
        "actor_class": {
          "enum": [
            "CODEX",
            "HUMAN_OWNER_RESEARCHER",
            "ALPHAQUEST_DETERMINISTIC_ENGINE"
          ],
          "title": "Actor Class",
          "type": "string"
        },
        "actor_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "title": "Actor Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "actor_class",
        "actor_id"
      ],
      "title": "ActorProvenanceV1",
      "type": "object"
    },
    "RecordReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,255}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_sha256"
      ],
      "title": "RecordReferenceV1",
      "type": "object"
    },
    "TaxonomyRefV1": {
      "additionalProperties": false,
      "properties": {
        "taxonomy_id": {
          "const": "alphaquest-economic-edge",
          "enum": [
            "alphaquest-economic-edge"
          ],
          "title": "Taxonomy Id",
          "type": "string"
        },
        "taxonomy_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Taxonomy Sha256",
          "type": "string"
        },
        "taxonomy_version": {
          "minimum": 1,
          "title": "Taxonomy Version",
          "type": "integer"
        }
      },
      "required": [
        "taxonomy_id",
        "taxonomy_version",
        "taxonomy_sha256"
      ],
      "title": "TaxonomyRefV1",
      "type": "object"
    }
  },
  "$id": "https://alphaquest.local/schemas/literature-dossier-freeze-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorProvenanceV1"
    },
    "append_sequence": {
      "minimum": 1,
      "title": "Append Sequence",
      "type": "integer"
    },
    "claim_refs": {
      "items": {
        "$ref": "#/$defs/RecordReferenceV1"
      },
      "minItems": 1,
      "title": "Claim Refs",
      "type": "array"
    },
    "dossier_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Dossier Id",
      "type": "string"
    },
    "dossier_revision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dossier Revision Sha256",
      "type": "string"
    },
    "evidence_relation_refs": {
      "items": {
        "$ref": "#/$defs/RecordReferenceV1"
      },
      "title": "Evidence Relation Refs",
      "type": "array"
    },
    "freeze_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Freeze Id",
      "type": "string"
    },
    "idempotency_key": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "previous_store_record_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Store Record Sha256"
    },
    "protocol_revision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Protocol Revision Sha256",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,255}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema": {
      "const": "alphaquest.literature-dossier-freeze/v1",
      "title": "Schema",
      "type": "string"
    },
    "search_completion_status": {
      "enum": [
        "COMPLETE_WITHIN_DECLARED_BOUNDS",
        "TERMINATED_WITH_DECLARED_GAPS"
      ],
      "title": "Search Completion Status",
      "type": "string"
    },
    "taxonomy_ref": {
      "$ref": "#/$defs/TaxonomyRefV1"
    },
    "unsatisfied_lanes": {
      "items": {
        "enum": [
          "SUPPORTING_OR_MOTIVATING",
          "NULL_OR_CONTRARY",
          "FAILED_REPLICATION",
          "REGIME_DEPENDENCE",
          "TRANSACTION_COST_OR_EXECUTION_OBJECTION",
          "ALTERNATIVE_EXPLANATION",
          "DATA_MINING_OR_MULTIPLE_TESTING"
        ],
        "type": "string"
      },
      "title": "Unsatisfied Lanes",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "record_id",
    "append_sequence",
    "recorded_at",
    "actor",
    "idempotency_key",
    "intent_sha256",
    "record_sha256",
    "freeze_id",
    "dossier_id",
    "dossier_revision_sha256",
    "protocol_revision_sha256",
    "claim_refs",
    "evidence_relation_refs",
    "search_completion_status",
    "unsatisfied_lanes",
    "taxonomy_ref"
  ],
  "title": "DossierFreezeV1",
  "type": "object"
}
