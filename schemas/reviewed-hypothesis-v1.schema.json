      "type": "boolean"
    },
    "proposal_id": {
      "title": "Proposal Id",
      "type": "string"
    },
    "proposal_payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Payload Sha256",
      "type": "string"
    },
    "proposal_validation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Validation Sha256",
      "type": "string"
    },
    "reviewed_source_artifact_sha256s": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Reviewed Source Artifact Sha256S",
      "type": "array"
    },
    "schema": {
      "const": "alphaquest.reviewed-hypothesis/v1",
      "default": "alphaquest.reviewed-hypothesis/v1",
      "enum": [
        "alphaquest.reviewed-hypothesis/v1"
      ],
      "title": "Schema",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "testing_authorized": {
      "const": false,
