{
  "$defs": {
    "ActorProvenanceV1": {
      "additionalProperties": false,
      "properties": {
        "actor_class": {
          "enum": [
            "CODEX",
            "HUMAN_OWNER_RESEARCHER",
            "ALPHAQUEST_DETERMINISTIC_ENGINE",
            "EXTERNAL_SYSTEM"
          ],
          "title": "Actor Class",
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "actor_class",
        "actor_id"
      ],
      "title": "ActorProvenanceV1",
      "type": "object"
    },
    "EvidenceReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "claim_locator": {
          "minLength": 1,
          "title": "Claim Locator",
          "type": "string"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "evidence_time": {
          "format": "date-time",
          "title": "Evidence Time",
          "type": "string"
        },
        "integrity": {
          "enum": [
            "HASH_BOUND",
            "LOCATOR_ONLY"
          ],
          "title": "Integrity",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "PAPER",
            "DATASET",
            "EXCHANGE_RESEARCH",
            "PRACTITIONER_RESEARCH",
            "MARKET_EVENT",
            "OTHER"
          ],
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_kind",
        "locator",
        "claim_locator",
        "evidence_time",
        "integrity"
      ],
      "title": "EvidenceReferenceV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorProvenanceV1"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceReferenceV1"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "known_conflicts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Known Conflicts",
      "type": "array"
    },
    "observation_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Observation Id",
      "type": "string"
    },
    "previous_revision_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Revision Sha256"
    },
    "record_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,255}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema": {
      "const": "alphaquest.edge-backlog-observation-revision/v1",
      "default": "alphaquest.edge-backlog-observation-revision/v1",
      "enum": [
        "alphaquest.edge-backlog-observation-revision/v1"
      ],
      "title": "Schema",
      "type": "string"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "statement_kind": {
      "enum": [
        "SOURCE_QUOTE",
        "FAITHFUL_PARAPHRASE",
        "RESEARCHER_SUMMARY"
      ],
      "title": "Statement Kind",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "recorded_at",
    "actor",
    "record_sha256",
    "observation_id",
    "revision",
    "statement",
    "statement_kind",
    "evidence_refs"
  ],
  "title": "ObservationRevisionV1",
  "type": "object"
}
