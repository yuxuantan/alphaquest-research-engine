            "CHATGPT_SUBSCRIPTION"
          ],
          "title": "Authentication Mode",
          "type": "string"
        },
        "codex_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
