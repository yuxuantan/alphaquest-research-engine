          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "runtime_request_sha256",
        "prompt_sha256",
        "output_schema_sha256",
        "repository_revision",
        "dirty_tree_sha256",
        "started_at",
        "finished_at",
