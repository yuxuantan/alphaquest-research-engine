        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "repository_revision": {
          "minLength": 1,
          "title": "Repository Revision",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "runtime_request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Request Sha256",
          "type": "string"
