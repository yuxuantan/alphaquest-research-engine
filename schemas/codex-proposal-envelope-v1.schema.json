  "required": [
    "proposal_id",
    "task_id",
    "task_type",
    "task_sha256",
    "context_packet_sha256",
    "inputs_sha256",
    "input_artifact_hashes",
    "proposal_schema",
    "payload",
    "payload_sha256",
    "produced_at",
