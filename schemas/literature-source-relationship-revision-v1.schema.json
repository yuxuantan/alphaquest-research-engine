{
  "$defs": {
    "ActorProvenanceV1": {
      "additionalProperties": false,
      "properties": {
        "actor_class": {
          "enum": [
            "CODEX",
            "HUMAN_OWNER_RESEARCHER",
            "ALPHAQUEST_DETERMINISTIC_ENGINE"
          ],
          "title": "Actor Class",
          "type": "string"
        },
        "actor_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "title": "Actor Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "actor_class",
        "actor_id"
      ],
      "title": "ActorProvenanceV1",
      "type": "object"
    },
    "RecordReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,255}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_sha256"
      ],
      "title": "RecordReferenceV1",
      "type": "object"
    }
  },
  "$id": "https://alphaquest.local/schemas/literature-source-relationship-revision-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorProvenanceV1"
    },
    "append_sequence": {
      "minimum": 1,
      "title": "Append Sequence",
      "type": "integer"
    },
    "assertion_evidence_refs": {
      "items": {
        "$ref": "#/$defs/RecordReferenceV1"
      },
      "title": "Assertion Evidence Refs",
      "type": "array"
    },
    "change_reason": {
      "minLength": 1,
      "title": "Change Reason",
      "type": "string"
    },
    "idempotency_key": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "object_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "object_kind": {
      "enum": [
        "WORK",
        "SOURCE_VERSION"
      ],
      "title": "Object Kind",
      "type": "string"
    },
    "predicate": {
      "enum": [
        "POSSIBLE_SAME_WORK",
        "POSSIBLE_SAME_VERSION",
        "SAME_WORK_AS",
        "SAME_VERSION_AS",
        "REVISION_OF",
        "PUBLISHED_SUCCESSOR_OF",
        "CORRECTS",
        "RETRACTS"
      ],
      "title": "Predicate",
      "type": "string"
    },
    "previous_revision_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Revision Sha256"
    },
    "previous_store_record_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Store Record Sha256"
    },
    "record_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,255}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "relationship_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Relationship Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema": {
      "const": "alphaquest.literature-source-relationship-revision/v1",
      "title": "Schema",
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "RETRACTED",
        "SUPERSEDED"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Subject Id",
      "type": "string"
    },
    "subject_kind": {
      "enum": [
        "WORK",
        "SOURCE_VERSION"
      ],
      "title": "Subject Kind",
      "type": "string"
    },
    "superseded_by_relationship_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By Relationship Id"
    }
  },
  "required": [
    "schema",
    "record_id",
    "append_sequence",
    "recorded_at",
    "actor",
    "idempotency_key",
    "intent_sha256",
    "record_sha256",
    "revision",
    "relationship_id",
    "subject_kind",
    "subject_id",
    "predicate",
    "object_kind",
    "object_id",
    "status",
    "change_reason"
  ],
  "title": "SourceRelationshipRevisionV1",
  "type": "object"
}
