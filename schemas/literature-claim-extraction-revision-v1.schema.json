{
  "$defs": {
    "ActorProvenanceV1": {
      "additionalProperties": false,
      "properties": {
        "actor_class": {
          "enum": [
            "CODEX",
            "HUMAN_OWNER_RESEARCHER",
            "ALPHAQUEST_DETERMINISTIC_ENGINE"
          ],
          "title": "Actor Class",
          "type": "string"
        },
        "actor_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "title": "Actor Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "actor_class",
        "actor_id"
      ],
      "title": "ActorProvenanceV1",
      "type": "object"
    },
    "ClaimLocationV1": {
      "additionalProperties": false,
      "properties": {
        "block_ordinal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Ordinal"
        },
        "byte_end": {
          "minimum": 1,
          "title": "Byte End",
          "type": "integer"
        },
        "byte_start": {
          "minimum": 0,
          "title": "Byte Start",
          "type": "integer"
        },
        "locator_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Locator Sha256",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "representation_kind": {
          "enum": [
            "PDF",
            "HTML",
            "STRUCTURED_ABSTRACT",
            "PLAIN_TEXT"
          ],
          "title": "Representation Kind",
          "type": "string"
        },
        "section_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Anchor"
        },
        "span_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Span Sha256",
          "type": "string"
        }
      },
      "required": [
        "representation_kind",
        "byte_start",
        "byte_end",
        "span_sha256",
        "locator_sha256"
      ],
      "title": "ClaimLocationV1",
      "type": "object"
    },
    "RecordReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,255}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_sha256"
      ],
      "title": "RecordReferenceV1",
      "type": "object"
    }
  },
  "$id": "https://alphaquest.local/schemas/literature-claim-extraction-revision-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorProvenanceV1"
    },
    "append_sequence": {
      "minimum": 1,
      "title": "Append Sequence",
      "type": "integer"
    },
    "capture_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Capture Id",
      "type": "string"
    },
    "capture_revision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Capture Revision Sha256",
      "type": "string"
    },
    "claim_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Claim Id",
      "type": "string"
    },
    "conflict_refs": {
      "items": {
        "$ref": "#/$defs/RecordReferenceV1"
      },
      "title": "Conflict Refs",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "correction_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correction Reason"
    },
    "extracted_representation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Extracted Representation Sha256",
      "type": "string"
    },
    "idempotency_key": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "location": {
      "$ref": "#/$defs/ClaimLocationV1"
    },
    "previous_revision_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Revision Sha256"
    },
    "previous_store_record_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Store Record Sha256"
    },
    "record_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,255}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "reliability": {
      "enum": [
        "ACTIVE",
        "CORRECTED",
        "WITHDRAWN_INVALID",
        "SOURCE_RETRACTED"
      ],
      "title": "Reliability",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema": {
      "const": "alphaquest.literature-claim-extraction-revision/v1",
      "title": "Schema",
      "type": "string"
    },
    "source_epistemic_form": {
      "enum": [
        "ASSOCIATION_REPORTED",
        "CAUSALITY_ASSERTED_BY_SOURCE",
        "MECHANISM_PROPOSED_BY_SOURCE",
        "NULL_RESULT",
        "LIMITATION",
        "METHODOLOGY_FACT",
        "OTHER"
      ],
      "title": "Source Epistemic Form",
      "type": "string"
    },
    "source_version_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Source Version Id",
      "type": "string"
    },
    "source_version_revision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Version Revision Sha256",
      "type": "string"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "statement_kind": {
      "enum": [
        "SOURCE_QUOTE",
        "FAITHFUL_PARAPHRASE"
      ],
      "title": "Statement Kind",
      "type": "string"
    },
    "work_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Work Id",
      "type": "string"
    },
    "work_revision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Work Revision Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "record_id",
    "append_sequence",
    "recorded_at",
    "actor",
    "idempotency_key",
    "intent_sha256",
    "record_sha256",
    "revision",
    "claim_id",
    "work_id",
    "work_revision_sha256",
    "source_version_id",
    "source_version_revision_sha256",
    "capture_id",
    "capture_revision_sha256",
    "content_sha256",
    "extracted_representation_sha256",
    "location",
    "statement",
    "statement_kind",
    "source_epistemic_form",
    "reliability"
  ],
  "title": "ClaimExtractionRevisionV1",
  "type": "object"
}
