{
  "$defs": {
    "ActorProvenanceV1": {
      "additionalProperties": false,
      "properties": {
        "actor_class": {
          "enum": [
            "CODEX",
            "HUMAN_OWNER_RESEARCHER",
            "ALPHAQUEST_DETERMINISTIC_ENGINE",
            "EXTERNAL_SYSTEM"
          ],
          "title": "Actor Class",
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "actor_class",
        "actor_id"
      ],
      "title": "ActorProvenanceV1",
      "type": "object"
    },
    "EconomicConceptsV1": {
      "additionalProperties": false,
      "properties": {
        "beneficiary_counterparty_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Beneficiary Counterparty Codes",
          "type": "array"
        },
        "causal_mechanism_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Causal Mechanism Code",
          "type": "string"
        },
        "cost_bearer_counterparty_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Cost Bearer Counterparty Codes",
          "type": "array"
        },
        "expected_effect_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Expected Effect Code",
          "type": "string"
        },
        "holding_horizon_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Holding Horizon Code",
          "type": "string"
        },
        "information_availability_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Information Availability Code",
          "type": "string"
        },
        "information_input_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Information Input Codes",
          "type": "array"
        },
        "instrument_ids": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "market_behavior_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Market Behavior Code",
          "type": "string"
        },
        "market_context_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Market Context Codes",
          "type": "array"
        },
        "transfer_rationale_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Transfer Rationale Code",
          "type": "string"
        }
      },
      "required": [
        "instrument_ids",
        "market_behavior_code",
        "causal_mechanism_code",
        "beneficiary_counterparty_codes",
        "cost_bearer_counterparty_codes",
        "transfer_rationale_code",
        "information_input_codes",
        "information_availability_code",
        "expected_effect_code",
        "holding_horizon_code",
        "market_context_codes"
      ],
      "title": "EconomicConceptsV1",
      "type": "object"
    },
    "ObservationReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "title": "Observation Id",
          "type": "string"
        },
        "observation_revision_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Observation Revision Sha256",
          "type": "string"
        },
        "role": {
          "enum": [
            "MOTIVATING",
            "SUPPORTING",
            "CONTRADICTING"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "observation_revision_sha256",
        "role"
      ],
      "title": "ObservationReferenceV1",
      "type": "object"
    },
    "TaxonomyRefV1": {
      "additionalProperties": false,
      "properties": {
        "taxonomy_id": {
          "const": "alphaquest-economic-edge",
          "enum": [
            "alphaquest-economic-edge"
          ],
          "title": "Taxonomy Id",
          "type": "string"
        },
        "taxonomy_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Taxonomy Sha256",
          "type": "string"
        },
        "taxonomy_version": {
          "minimum": 1,
          "title": "Taxonomy Version",
          "type": "integer"
        }
      },
      "required": [
        "taxonomy_id",
        "taxonomy_version",
        "taxonomy_sha256"
      ],
      "title": "TaxonomyRefV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorProvenanceV1"
    },
    "append_sequence": {
      "minimum": 1,
      "title": "Append Sequence",
      "type": "integer"
    },
    "classification_status": {
      "enum": [
        "CLASSIFIED",
        "NEEDS_CLASSIFICATION"
      ],
      "title": "Classification Status",
      "type": "string"
    },
    "economic_concepts": {
      "anyOf": [
        {
          "$ref": "#/$defs/EconomicConceptsV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "entry_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
      "title": "Entry Id",
      "type": "string"
    },
    "fingerprint_schema": {
      "anyOf": [
        {
          "const": "alphaquest.edge-backlog-fingerprint/v1",
          "enum": [
            "alphaquest.edge-backlog-fingerprint/v1"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fingerprint Schema"
    },
    "fingerprint_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fingerprint Sha256"
    },
    "governance_scope": {
      "const": "PRE_HYPOTHESIS_BACKLOG_ONLY",
      "enum": [
        "PRE_HYPOTHESIS_BACKLOG_ONLY"
      ],
      "title": "Governance Scope",
      "type": "string"
    },
    "observation_refs": {
      "items": {
        "$ref": "#/$defs/ObservationReferenceV1"
      },
      "minItems": 1,
      "title": "Observation Refs",
      "type": "array"
    },
    "p1_evidence_eligibility": {
      "const": "NOT_CURRENT_P1_EVIDENCE",
      "enum": [
        "NOT_CURRENT_P1_EVIDENCE"
      ],
      "title": "P1 Evidence Eligibility",
      "type": "string"
    },
    "previous_revision_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Revision Sha256"
    },
    "record_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,255}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema": {
      "const": "alphaquest.edge-backlog-entry-revision/v1",
      "default": "alphaquest.edge-backlog-entry-revision/v1",
      "enum": [
        "alphaquest.edge-backlog-entry-revision/v1"
      ],
      "title": "Schema",
      "type": "string"
    },
    "taxonomy_ref": {
      "$ref": "#/$defs/TaxonomyRefV1"
    },
    "unclassified_reason": {
      "anyOf": [
        {
          "enum": [
            "AMBIGUOUS_CAUSAL_MECHANISM",
            "CONFLICTING_OBSERVATIONS",
            "INSUFFICIENT_SOURCE_CONTEXT",
            "MIXED_ECONOMIC_PHENOMENA",
            "NOVEL_CONCEPT_NOT_IN_TAXONOMY"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unclassified Reason"
    }
  },
  "required": [
    "record_id",
    "append_sequence",
    "recorded_at",
    "actor",
    "record_sha256",
    "entry_id",
    "revision",
    "classification_status",
    "taxonomy_ref",
    "governance_scope",
    "p1_evidence_eligibility",
    "economic_concepts",
    "unclassified_reason",
    "observation_refs",
    "fingerprint_schema",
    "fingerprint_sha256"
  ],
  "title": "EdgeBacklogEntryRevisionV1",
  "type": "object"
}
