          "type": "array"
        },
        "position_limits": {
          "minLength": 10,
          "title": "Position Limits",
          "type": "string"
        },
        "rationale": {
          "minLength": 20,
          "title": "Rationale",
          "type": "string"
        },
        "reentry_policy": {
          "minLength": 10,
          "title": "Reentry Policy",
          "type": "string"
        },
        "required_data_fields": {
