            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certified Strategy Id"
        },
        "confirmed": {
          "const": false,
          "default": false,
          "enum": [
            false
          ],
          "title": "Confirmed",
          "type": "boolean"
        },
        "entry_state_machine": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
