          "type": "string"
        },
        "invalidation_condition": {
          "minLength": 10,
          "title": "Invalidation Condition",
          "type": "string"
        },
        "mechanics_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Mechanics Id",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterIntentV1"
