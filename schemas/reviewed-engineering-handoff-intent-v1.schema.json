            "type": "string"
          },
          "minItems": 1,
          "title": "Required Data Fields",
          "type": "array"
        },
        "schema": {
          "const": "alphaquest.mechanics-intent/v1",
          "default": "alphaquest.mechanics-intent/v1",
          "enum": [
            "alphaquest.mechanics-intent/v1"
          ],
          "title": "Schema",
          "type": "string"
        },
        "session_boundaries": {
          "minLength": 10,
          "title": "Session Boundaries",
          "type": "string"
        },
        "signal_availability": {
          "minLength": 10,
          "title": "Signal Availability",
          "type": "string"
        },
        "status": {
          "const": "PROPOSAL",
          "default": "PROPOSAL",
          "enum": [
            "PROPOSAL"
          ],
          "title": "Status",
          "type": "string"
        },
        "stop_semantics": {
          "minLength": 10,
          "title": "Stop Semantics",
          "type": "string"
        },
        "target_and_exit_semantics": {
          "minLength": 10,
          "title": "Target And Exit Semantics",
          "type": "string"
        },
        "unsupported_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unsupported Reason"
