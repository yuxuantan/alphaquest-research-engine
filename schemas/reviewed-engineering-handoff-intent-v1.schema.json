          "const": "PASS",
          "default": "PASS",
          "enum": [
            "PASS"
          ],
          "title": "Causal Timeline Reviewed",
          "type": "string"
        },
        "decision": {
          "const": "ACCEPT_FOR_ENGINEERING_HANDOFF",
          "default": "ACCEPT_FOR_ENGINEERING_HANDOFF",
          "enum": [
            "ACCEPT_FOR_ENGINEERING_HANDOFF"
          ],
          "title": "Decision",
          "type": "string"
        },
        "hypothesis_alignment": {
          "const": "PASS",
          "default": "PASS",
          "enum": [
            "PASS"
          ],
          "title": "Hypothesis Alignment",
          "type": "string"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        },
        "review_id": {
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewed_fields": {
          "items": {
            "type": "string"
          },
          "title": "Reviewed Fields",
          "type": "array"
        },
        "reviewer": {
          "title": "Reviewer",
          "type": "string"
        },
        "unsupported_scope_confirmed": {
          "const": "PASS",
          "default": "PASS",
          "enum": [
            "PASS"
          ],
          "title": "Unsupported Scope Confirmed",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "reviewer",
        "reviewed_at",
        "reviewed_fields",
        "notes"
      ],
      "title": "EngineeringHandoffIntentHumanAcceptanceV1",
      "type": "object"
    },
    "MechanicsIntentV1": {
